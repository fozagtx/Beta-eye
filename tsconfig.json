{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome", "node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["*.js", "lib/**/*.js", "scripts/**/*.mjs", "tests/**/*.js", "types/**/*.d.ts"],
  "exclude": ["dist"]
}
